{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.malikacodes.apple-music",
  "Name": "Apple Music",
  "Author": "Malika Pixels",
  "Description": "Keys and dials for the Music app on my Mac, the way Elgato's Spotify plugin does it for Spotify.",
  "Version": "0.1.0.0",
  "SDKVersion": 3,
  "CodePath": "bin/plugin.js",
  "Icon": "imgs/plugin",
  "CategoryIcon": "imgs/note",
  "Category": "Apple Music",
  "Nodejs": {
    "Version": "24"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Actions": [
    {
      "UUID": "com.malikacodes.apple-music.playback",
      "Name": "Playback",
      "Tooltip": "Play or pause, go back a track, or skip ahead",
      "Icon": "imgs/playpause",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "PropertyInspectorPath": "ui/playback.html",
      "States": [
        {
          "Image": "imgs/playpause-key"
        }
      ]
    },
    {
      "UUID": "com.malikacodes.apple-music.shuffle",
      "Name": "Shuffle",
      "Tooltip": "Turn shuffle on or off",
      "Icon": "imgs/shuffle",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/shuffle-key"
        }
      ]
    },
    {
      "UUID": "com.malikacodes.apple-music.repeat",
      "Name": "Repeat",
      "Tooltip": "Repeat off, the whole list, or one song",
      "Icon": "imgs/repeat",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/repeat-key"
        }
      ]
    },
    {
      "UUID": "com.malikacodes.apple-music.favorite",
      "Name": "Favorite",
      "Tooltip": "Favorite the song that is playing, or take it back",
      "Icon": "imgs/favorite",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/favorite-key"
        }
      ]
    },
    {
      "UUID": "com.malikacodes.apple-music.volume",
      "Name": "Volume",
      "Tooltip": "Turn for Music's volume, push to mute",
      "Icon": "imgs/volume",
      "Controllers": ["Encoder"],
      "UserTitleEnabled": false,
      "PropertyInspectorPath": "ui/volume.html",
      "Encoder": {
        "layout": "layouts/strip.json",
        "TriggerDescription": {
          "Rotate": "Volume",
          "Push": "Mute",
          "Touch": "Mute"
        }
      },
      "States": [
        {
          "Image": "imgs/volume-dial"
        }
      ]
    },
    {
      "UUID": "com.malikacodes.apple-music.multimedia",
      "Name": "Multimedia",
      "Tooltip": "What's playing, with volume or skipping on the turn",
      "Icon": "imgs/multimedia",
      "Controllers": ["Encoder"],
      "UserTitleEnabled": false,
      "PropertyInspectorPath": "ui/multimedia.html",
      "Encoder": {
        "layout": "layouts/strip.json",
        "TriggerDescription": {
          "Rotate": "Volume or skip",
          "Push": "Play / Pause",
          "Touch": "Play / Pause"
        }
      },
      "States": [
        {
          "Image": "imgs/multimedia-dial"
        }
      ]
    }
  ]
}
